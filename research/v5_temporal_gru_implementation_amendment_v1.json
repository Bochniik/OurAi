{
  "schema_version": 1,
  "amendment_name": "ourai-v5-temporal-gru-implementation-amendment-v1",
  "parent_protocol": "ourai-v5-temporal-market-context-direction-v1",
  "reason": "Freeze implementation details that were underspecified in the parent protocol before any v5 GRU model result is observed.",
  "data_access": {
    "target_split": "v4 train.jsonl only",
    "market_context_split": "v5 market-context train.jsonl only",
    "v4_validation_accessed": false,
    "v4_test_accessed": false,
    "context_validation_accessed": false,
    "context_test_accessed": false
  },
  "sequence_construction": {
    "length_observations": 60,
    "requires_exact_consecutive_one_minute_target_timestamps": true,
    "sequence_ends_at_prediction_sample_timestamp": true,
    "market_context_join": "exact_same_availability_timestamp",
    "context_roles": ["SPY", "QQQ", "SECTOR_ETF"],
    "context_targets_used": false,
    "missing_numeric_values": "zero_after_train_only_standardization_plus_explicit_binary_mask",
    "normalization_observation_weighting": "unique_training_feature_rows"
  },
  "magnitude_gate": {
    "lineage": "carry_forward_exact_v4_selective_magnitude_gate",
    "family": "HistGradientBoostingRegressor",
    "loss": "absolute_error",
    "learning_rate": 0.05,
    "max_iter": 150,
    "max_leaf_nodes": 31,
    "min_samples_leaf": 100,
    "l2_regularization": 1.0,
    "max_bins": 255,
    "early_stopping": false,
    "random_state": 42,
    "training_tail_quantile": 0.7,
    "predicted_gate_quantile": 0.7
  },
  "gru_training": {
    "hidden_size": 64,
    "num_layers": 2,
    "dropout": 0.1,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "epochs": 5,
    "batch_size": 256,
    "gradient_clip_norm": 1.0,
    "seed": 42,
    "loss": "BCEWithLogitsLoss",
    "early_stopping": false,
    "normalization_fit_scope": "current walk-forward training fold only"
  },
  "comparators": {
    "original_linear": "v4 shared logistic direction baseline trained on the full current walk-forward training fold",
    "tail_null": "training-fold UP rate among upper-30-percent realized-magnitude directional rows",
    "all_comparators_evaluated_on_exact_same_selected_directional_rows": true
  },
  "development_gate": {
    "fold_count": 7,
    "minimum_brier_wins_vs_original_linear": 5,
    "minimum_brier_wins_vs_tail_null": 5,
    "require_lower_mean_brier_than_both": true,
    "require_lower_mean_log_loss_than_both": true,
    "minimum_mean_selected_coverage": 0.1,
    "pnl_used": false
  },
  "promotion": {
    "passing_development_does_not_authorize_validation": true,
    "separate_frozen_validation_gate_required": true
  }
}
